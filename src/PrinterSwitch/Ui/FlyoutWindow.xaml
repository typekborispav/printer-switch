<Window x:Class="PrinterSwitch.Ui.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PrinterSwitch.Core"
        Title="{core:Tr app.name}"
        Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="8" />
    </WindowChrome.WindowChrome>

    <StackPanel Margin="20,18,20,16">
        <!-- header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Badge" Width="44" Height="44" CornerRadius="22" Background="Gray">
                <TextBlock x:Name="BadgeGlyph" Style="{StaticResource Glyph}" FontSize="20"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{core:Tr app.name}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
            <Button Grid.Column="2" x:Name="SettingsButton" Padding="8" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" ToolTip="{core:Tr action.settings}"
                    Click="Settings_Click">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <!-- status card -->
        <Border Margin="0,16,0,0" Padding="16,12,8,14" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,2,0,0">
                    <TextBlock x:Name="StateTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="StateDetail" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
                    <TextBlock x:Name="LastCheck" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Margin="0,12,8,0" Visibility="Collapsed" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="RefreshButton" Padding="8" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="{core:Tr action.refresh}" Click="Refresh_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>
        </Border>

        <!-- main action -->
        <Button x:Name="MainButton" Margin="0,14,0,0" Height="40" HorizontalAlignment="Stretch"
                Style="{DynamicResource AccentButtonStyle}" Click="Main_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="MainGlyph" Style="{StaticResource Glyph}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="MainText" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- links -->
        <StackPanel Margin="-8,12,-8,0">
            <Button x:Name="UpdateLink" Style="{StaticResource RowButton}" Click="Update_Click" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="UpdateLinkText" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </Button>
            <Button x:Name="CupsLink" Style="{StaticResource RowButton}" Click="Cups_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{core:Tr action.cups}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="PrinterLink" Style="{StaticResource RowButton}" Click="Printer_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{core:Tr action.addprinter}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource RowButton}" Click="Log_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE9F9;" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{core:Tr action.log}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
