<Window x:Class="PrinterSwitch.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PrinterSwitch.Core"
        xmlns:ui="clr-namespace:PrinterSwitch.Ui"
        Title="{core:Tr set.title}"
        Width="1000" Height="700" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Shown only when moving with the keyboard, like Windows 11. -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="7" RadiusY="7" StrokeThickness="2"
                                   Stroke="{DynamicResource FocusStrokeColorOuterBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- One row of a settings page, like Windows 11 Settings. -->
        <Style TargetType="ui:SettingsCard">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:SettingsCard">
                        <Border x:Name="Bd" CornerRadius="6" MinHeight="68" Padding="16,12,16,12"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" Text="{TemplateBinding Glyph}" FontFamily="{StaticResource GlyphFont}"
                                           FontSize="20" Margin="4,0,20,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{TemplateBinding Header}" FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock x:Name="Desc" Text="{TemplateBinding Description}" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                                <TextBlock x:Name="Chevron" Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource GlyphFont}"
                                           FontSize="12" Margin="16,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Description" Value=""><Setter TargetName="Desc" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="Description" Value="{x:Null}"><Setter TargetName="Desc" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="Glyph" Value=""><Setter TargetName="Icon" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="IsClickable" Value="True">
                                <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Trigger>
                            <Trigger Property="IsExternal" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE8A7;" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsClickable" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 toggle switch with the On / Off label in front of it. -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="StateText" Text="{core:Tr toggle.off}" FontSize="14" MinWidth="60"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Grid Width="40" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                        Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                                <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                         Fill="{DynamicResource TextFillColorSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="KnobScale" />
                                            <TranslateTransform x:Name="KnobMove" />
                                        </TransformGroup>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StateText" Property="Text" Value="{core:Tr toggle.on}" />
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.17" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1.17" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation entries on the left: subtle fill and an accent pill when selected. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="4" Height="38" Margin="0,2" Background="Transparent">
                            <Grid>
                                <Rectangle x:Name="Pill" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                                           Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                                <ContentPresenter Margin="16,0,12,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,24,0,8" />
        </Style>
        <Style x:Key="CardBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="260" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- navigation -->
        <DockPanel Margin="16,16,8,16">
            <Grid DockPanel.Dock="Top" Margin="4,4,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Assets/app-256.png" Width="56" Height="56"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{core:Tr app.name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="NavState" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
            <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource NavItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Nav_Changed">
                <ListBoxItem Tag="general">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;" />
                        <TextBlock Style="{StaticResource NavText}" Text="{core:Tr set.nav.general}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="connection">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE968;" />
                        <TextBlock Style="{StaticResource NavText}" Text="{core:Tr set.nav.connection}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="printer">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE749;" />
                        <TextBlock Style="{StaticResource NavText}" Text="{core:Tr set.nav.printer}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="pc">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE977;" />
                        <TextBlock Style="{StaticResource NavText}" Text="{core:Tr set.nav.pc}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="updates">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE895;" />
                        <TextBlock Style="{StaticResource NavText}" Text="{core:Tr set.nav.updates}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="about">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE946;" />
                        <TextBlock Style="{StaticResource NavText}" Text="{core:Tr action.about}" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- pages -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" Margin="40,28,40,12" />
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="40,0,40,36" MaxWidth="1000" HorizontalAlignment="Stretch">

                    <!-- general -->
                    <StackPanel x:Name="PageGeneral">
                        <ui:SettingsCard x:Name="WizardCard" Glyph="&#xE82F;" Margin="0,8,0,4"
                                         Header="{core:Tr set.wizard.t}" Description="{core:Tr set.wizard.d}">
                            <Button Style="{DynamicResource AccentButtonStyle}" MinWidth="140" Content="{core:Tr action.setup}" Click="Wizard_Click" />
                        </ui:SettingsCard>

                        <TextBlock Style="{StaticResource GroupHeader}" Text="{core:Tr set.group.app}" />
                        <ui:SettingsCard Glyph="&#xE774;" Header="{core:Tr set.lang.t}" Description="{core:Tr set.lang.d}">
                            <ComboBox x:Name="LanguageBox" MinWidth="200" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xE7E8;" Header="{core:Tr set.autostart.t}" Description="{core:Tr set.autostart.d}">
                            <CheckBox x:Name="AutostartSwitch" Style="{StaticResource ToggleSwitch}" />
                        </ui:SettingsCard>
                        <ui:SettingsCard x:Name="PinCard" Glyph="&#xE718;" Header="{core:Tr set.pin.t}" Description="{core:Tr set.pin.d}">
                            <CheckBox x:Name="PinSwitch" Style="{StaticResource ToggleSwitch}" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xE916;" Header="{core:Tr set.interval.t}" Description="{core:Tr set.interval.d}">
                            <ComboBox x:Name="IntervalBox" MinWidth="120" />
                        </ui:SettingsCard>
                    </StackPanel>

                    <!-- connection -->
                    <StackPanel x:Name="PageConnection" Visibility="Collapsed">
                        <!-- current state, like the top card of Network & internet -->
                        <Border CornerRadius="6" Padding="20,16" Margin="0,8,0,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Badge" Width="48" Height="48" CornerRadius="24" Background="Gray">
                                    <TextBlock x:Name="BadgeGlyph" Style="{StaticResource Glyph}" FontSize="22" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="StatusSub" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="StatusRefresh" VerticalAlignment="Center" Click="StatusRefresh_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{core:Tr action.refresh}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource GroupHeader}" Text="{core:Tr set.group.server}" />
                        <ui:SettingsCard Glyph="&#xE968;" Header="{core:Tr wiz.server.host}">
                            <TextBox x:Name="HostBox" Style="{StaticResource CardBox}" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xE71B;" Header="{core:Tr set.port.ssh}">
                            <TextBox x:Name="PortBox" Width="100" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xE77B;" Header="{core:Tr wiz.server.user}">
                            <TextBox x:Name="UserBox" Style="{StaticResource CardBox}" />
                        </ui:SettingsCard>
                        <ui:SettingsCard x:Name="KeyCard" Glyph="&#xE8D7;" Header="{core:Tr set.key.t}">
                            <Button Content="{core:Tr set.key.change}" MinWidth="100" Click="Key_Click" />
                        </ui:SettingsCard>
                        <ui:SettingsCard x:Name="FpCard" Glyph="&#xE928;" Header="{core:Tr set.fp.t}">
                            <Button x:Name="ForgetButton" Content="{core:Tr set.fp.forget}" MinWidth="100" Click="Forget_Click" />
                        </ui:SettingsCard>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="SaveButton" Style="{DynamicResource AccentButtonStyle}" MinWidth="150" Click="Save_Click" />
                                <Button x:Name="RevertButton" Margin="8,0,0,0" MinWidth="110" Content="{core:Tr set.conn.revert}" Click="Revert_Click" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                <ProgressBar x:Name="ConnProgress" IsIndeterminate="True" Width="80" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="ConnResult" Margin="2,12,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ConnGlyph" Style="{StaticResource Glyph}" FontSize="16" Margin="0,2,10,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="ConnText" Style="{StaticResource Body}" />
                                <TextBlock x:Name="ConnSub" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource GroupHeader}" Text="{core:Tr set.group.maint}" />
                        <ui:SettingsCard Glyph="&#xE90F;" IsClickable="True" Header="{core:Tr set.prep.t}" Description="{core:Tr set.prep.d}" Click="Prepare_Click" />
                        <ui:SettingsCard Glyph="&#xE950;" IsClickable="True" Header="{core:Tr set.pi.t}" Description="{core:Tr set.pi.d}" Click="Pi_Click" />
                        <ui:SettingsCard x:Name="CupsCard" Glyph="&#xE909;" IsClickable="True" IsExternal="True"
                                         Header="{core:Tr action.cups}" Description="{core:Tr set.cups.d}" Click="Cups_Click" />
                    </StackPanel>

                    <!-- printer -->
                    <StackPanel x:Name="PagePrinter" Visibility="Collapsed">
                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ProgressBar x:Name="LoadProgress" IsIndeterminate="True" Width="80" Margin="2,0,12,0" Visibility="Collapsed" />
                                <TextBlock x:Name="LoadText" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="LoadButton" Click="Load_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{core:Tr set.printer.load}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ui:SettingsCard Glyph="&#xE88E;" Header="{core:Tr wiz.prep.device}" Description="{core:Tr set.dev.d}">
                            <ComboBox x:Name="DeviceBox" MinWidth="280" MaxWidth="380" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xE8FD;" Header="{core:Tr wiz.prep.queue}" Description="{core:Tr set.queue.d}">
                            <ComboBox x:Name="QueueBox" MinWidth="200" MaxWidth="320" />
                        </ui:SettingsCard>

                        <TextBlock Style="{StaticResource GroupHeader}" Text="{core:Tr set.group.windows}" />
                        <ui:SettingsCard Glyph="&#xE710;" Header="{core:Tr action.addprinter}" Description="{core:Tr set.add.d}">
                            <Button x:Name="AddPrinterButton" MinWidth="100" Content="{core:Tr set.add.button}" Click="AddPrinter_Click" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xE909;" IsClickable="True" IsExternal="True"
                                         Header="{core:Tr action.cups}" Description="{core:Tr set.cups.d}" Click="Cups_Click" />
                        <ui:SettingsCard Glyph="&#xE749;" IsClickable="True" IsExternal="True"
                                         Header="{core:Tr set.winprinters.t}" Description="{core:Tr set.winprinters.d}" Click="WinPrinters_Click" />
                    </StackPanel>

                    <!-- this pc -->
                    <StackPanel x:Name="PagePc" Visibility="Collapsed">
                        <ui:SettingsCard x:Name="UsbipCard" Glyph="&#xE88E;" Margin="0,8,0,4" Header="{core:Tr set.usbip.t}">
                            <Button x:Name="InstallButton" Style="{DynamicResource AccentButtonStyle}" Click="Install_Click" />
                        </ui:SettingsCard>
                        <ProgressBar x:Name="InstallProgress" Margin="2,4,2,0" Maximum="1" Visibility="Collapsed" />
                        <TextBlock x:Name="InstallText" Style="{StaticResource Body}" Margin="2,6,0,4" />

                        <TextBlock Style="{StaticResource GroupHeader}" Text="{core:Tr set.group.advanced}" />
                        <ui:SettingsCard Glyph="&#xE71B;" Header="{core:Tr set.port.t}" Description="{core:Tr set.port.d}">
                            <TextBox x:Name="LocalPortBox" Width="100" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xE9F9;" IsClickable="True" IsExternal="True"
                                         Header="{core:Tr set.log.t}" Description="{core:Tr set.log.d}" Click="Log_Click" />
                        <ui:SettingsCard x:Name="FolderCard" Glyph="&#xE8B7;" IsClickable="True" IsExternal="True"
                                         Header="{core:Tr set.folder.t}" Click="Folder_Click" />
                    </StackPanel>

                    <!-- updates -->
                    <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                        <Border CornerRadius="6" Padding="20,16" Margin="0,8,0,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="UpdBadge" Width="48" Height="48" CornerRadius="24">
                                        <TextBlock x:Name="UpdBadgeGlyph" Style="{StaticResource Glyph}" FontSize="22" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="UpdTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="UpdSub" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" x:Name="UpdButton" MinWidth="160" VerticalAlignment="Center" Click="Update_Click" />
                                </Grid>
                                <ProgressBar x:Name="UpdProgress" Margin="0,14,0,0" Maximum="1" Visibility="Collapsed" />
                                <TextBlock x:Name="UpdText" Style="{StaticResource Body}" FontSize="13" Margin="0,10,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ui:SettingsCard x:Name="NotesCard" Glyph="&#xE7C3;" IsClickable="True" IsExternal="True" Margin="0,4,0,4"
                                         Header="{core:Tr upd.notes.t}" Click="Notes_Click" />
                        <TextBlock Style="{StaticResource GroupHeader}" Text="{core:Tr set.group.app}" />
                        <ui:SettingsCard Glyph="&#xE895;" Header="{core:Tr upd.auto.t}" Description="{core:Tr upd.auto.d}">
                            <CheckBox x:Name="AutoUpdateSwitch" Style="{StaticResource ToggleSwitch}" />
                        </ui:SettingsCard>
                        <ui:SettingsCard Glyph="&#xE8F1;" IsClickable="True" IsExternal="True"
                                         Header="{core:Tr upd.all.t}" Description="{core:Tr upd.all.d}" Click="Releases_Click" />
                    </StackPanel>

                    <!-- about -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <Border CornerRadius="6" Padding="20,18" Margin="0,8,0,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="pack://application:,,,/Assets/app-256.png" Width="64" Height="64"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{core:Tr app.name}" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border CornerRadius="6" Padding="20,16" Margin="0,4,0,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{core:Tr set.license.t}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{core:Tr about.text}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource GroupHeader}" Text="{core:Tr set.group.links}" />
                        <ui:SettingsCard Glyph="&#xE943;" IsClickable="True" IsExternal="True"
                                         Header="{core:Tr set.github.t}" Description="{core:Tr set.github.d}" Click="GitHub_Click" />
                        <ui:SettingsCard Glyph="&#xE8A5;" IsClickable="True" IsExternal="True"
                                         Header="{core:Tr about.notices}" Description="{core:Tr set.notices.d}" Click="Notices_Click" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
