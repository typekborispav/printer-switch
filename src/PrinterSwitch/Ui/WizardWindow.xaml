<Window x:Class="PrinterSwitch.Ui.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PrinterSwitch.Core"
        Title="{core:Tr wiz.title}"
        Width="820" Height="600" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,16,0,0" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- step list -->
        <StackPanel Grid.RowSpan="2" Margin="20,28,8,20">
            <StackPanel Orientation="Horizontal" Margin="4,0,0,24">
                <Image Source="pack://application:,,,/Assets/app-256.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{core:Tr app.name}" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <ItemsControl x:Name="StepList" />
        </StackPanel>

        <!-- pages -->
        <Border Grid.Column="1" Margin="0,16,16,0" CornerRadius="8"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,24">
                <Grid>
                    <!-- 1 welcome -->
                    <StackPanel x:Name="Page0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE749;" FontSize="40"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Subtitle}" FontSize="24" Margin="0,16,0,0" Text="{core:Tr wiz.welcome.h}" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0" Text="{core:Tr wiz.welcome.p1}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" FontSize="14" Text="{core:Tr wiz.welcome.need}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE968;" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Body}" Margin="12,0,0,0" Text="{core:Tr wiz.welcome.b1}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D7;" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Body}" Margin="12,0,0,0" Text="{core:Tr wiz.welcome.b2}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE88E;" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Body}" Margin="12,0,0,0" Text="{core:Tr wiz.welcome.b3}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2 server -->
                    <StackPanel x:Name="Page1" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Subtitle}" Text="{core:Tr wiz.server.h}" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Text="{core:Tr wiz.server.p}" />
                        <Border Style="{StaticResource Card}" Padding="8,8,8,8">
                            <StackPanel>
                                <Grid Margin="8,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DiscoverText" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Text="{core:Tr wiz.find.hint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ProgressBar x:Name="DiscoverProgress" IsIndeterminate="True" Width="80" Margin="0,0,12,0"
                                                     Visibility="Collapsed" VerticalAlignment="Center" />
                                        <Button x:Name="DiscoverButton" Content="{core:Tr wiz.find.button}" Click="Discover_Click" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="FoundList" Margin="0,8,0,0" Visibility="Collapsed" MaxHeight="180"
                                         Background="Transparent" BorderThickness="0" SelectionChanged="Found_Selected">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock FontSize="14">
                                                    <Run Text="{Binding Host, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="  " /><Run Text="{Binding Address, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Printers, Mode=OneWay}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{core:Tr wiz.server.host}" />
                                <TextBox x:Name="HostBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{core:Tr wiz.server.port}" />
                                <TextBox x:Name="PortBox" Text="22" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{core:Tr wiz.server.user}" />
                        <TextBox x:Name="UserBox" />
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="ConnectButton" Style="{DynamicResource AccentButtonStyle}" MinWidth="120"
                                    Content="{core:Tr wiz.server.connect}" Click="Connect_Click" />
                            <ProgressBar x:Name="ConnectProgress" IsIndeterminate="True" Width="120"
                                         Margin="16,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border x:Name="ServerResult" Style="{StaticResource Card}" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ServerResultGlyph" Style="{StaticResource Glyph}" FontSize="18" Margin="0,1,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="ServerResultText" Style="{StaticResource Body}" />
                                    <TextBlock x:Name="ServerResultSub" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="PasswordPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Body}" Margin="0,16,0,0" Text="{core:Tr wiz.server.needpw}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{core:Tr wiz.server.password}" />
                            <PasswordBox x:Name="PasswordBox" />
                            <Button Margin="0,14,0,0" HorizontalAlignment="Left" Content="{core:Tr wiz.server.setupkey}" Click="SetupKey_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 3 prepare -->
                    <StackPanel x:Name="Page2" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Subtitle}" Text="{core:Tr wiz.prep.h}" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Text="{core:Tr wiz.prep.p}" />
                        <Border Style="{StaticResource Card}">
                            <Grid x:Name="CheckGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="CupsGlyph" Style="{StaticResource Glyph}" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource StepText}" Text="{core:Tr wiz.prep.cups}" />
                                <TextBlock Grid.Column="2" x:Name="CupsState" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" x:Name="HelperGlyph" Style="{StaticResource Glyph}" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StepText}" Text="{core:Tr wiz.prep.helper}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="HelperState" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" x:Name="UsbipGlyph" Style="{StaticResource Glyph}" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StepText}" Text="{core:Tr wiz.prep.usbip}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="UsbipState" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{core:Tr wiz.prep.device}" />
                                <ComboBox x:Name="DeviceBox" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{core:Tr wiz.prep.queue}" />
                                <ComboBox x:Name="QueueBox" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="NoDeviceText" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="{core:Tr wiz.prep.nodevice}" Visibility="Collapsed" />
                        <StackPanel x:Name="SudoPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Body}" Margin="0,16,0,0" Text="{core:Tr wiz.prep.sudoneeded}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{core:Tr wiz.prep.sudopw}" />
                            <PasswordBox x:Name="SudoBox" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="PrepareButton" Style="{DynamicResource AccentButtonStyle}" MinWidth="140"
                                    Content="{core:Tr wiz.prep.run}" Click="Prepare_Click" />
                            <ProgressBar x:Name="PrepareProgress" IsIndeterminate="True" Width="120"
                                         Margin="16,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="PrepareText" Style="{StaticResource Body}" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- 4 this PC -->
                    <StackPanel x:Name="Page3" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Subtitle}" Text="{core:Tr wiz.pc.h}" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Text="{core:Tr wiz.pc.p}" />
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="UsbipPcGlyph" Style="{StaticResource Glyph}" FontSize="18" Margin="0,1,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="UsbipPcText" Style="{StaticResource Body}" />
                                    <TextBlock x:Name="UsbipPcSub" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="InstallButton" Style="{DynamicResource AccentButtonStyle}" Click="Install_Click" />
                        </StackPanel>
                        <ProgressBar x:Name="InstallProgress" Margin="0,14,0,0" Maximum="1" Visibility="Collapsed" />
                        <TextBlock x:Name="InstallText" Style="{StaticResource Body}" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,18,0,0" Text="{core:Tr wiz.pc.source}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{core:Tr wiz.pc.optional}" />
                    </StackPanel>

                    <!-- 5 done -->
                    <StackPanel x:Name="Page4" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE930;" FontSize="40"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Subtitle}" FontSize="24" Margin="0,16,0,0" Text="{core:Tr wiz.done.h}" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Text="{core:Tr wiz.done.p}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="AutostartBox" Content="{core:Tr wiz.done.autostart}" IsChecked="True" />
                                <CheckBox x:Name="PromoteBox" Margin="0,8,0,0" Content="{core:Tr wiz.done.promote}" IsChecked="True" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="{core:Tr wiz.done.language}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox x:Name="LanguageBox" MinWidth="180" />
                                </StackPanel>
                                <TextBlock x:Name="LanguageNote" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           Text="{core:Tr wiz.lang.note}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" FontSize="14" Text="{core:Tr wiz.done.printer.h}" />
                                <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" Text="{core:Tr wiz.done.printer.p}" />
                                <Button x:Name="AddPrinterButton" Margin="0,12,0,0" HorizontalAlignment="Left"
                                        Content="{core:Tr action.addprinter}" Click="AddPrinter_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- buttons -->
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,16,16">
            <Button x:Name="BackButton" MinWidth="110" Content="{core:Tr wiz.back}" Click="Back_Click" />
            <Button x:Name="NextButton" MinWidth="110" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}"
                    Content="{core:Tr wiz.next}" Click="Next_Click" IsDefault="True" />
            <Button MinWidth="110" Margin="8,0,0,0" Content="{core:Tr action.cancel}" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
